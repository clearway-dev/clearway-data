# =============================================================================
# ClearWay Mobile App — Environment Variables
# Copy this file to .env and fill in the values.
# After changing .env, restart the Expo dev server.
# =============================================================================

# Backend API base URL reachable from the mobile device.
# Do NOT use localhost — physical devices cannot reach it.
# Use your machine IP (e.g. http://192.168.1.10:8000) or a public URL.
EXPO_PUBLIC_API_URL=https://api-mobile.clearway.zephyron.tech
