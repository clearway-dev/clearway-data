# =============================================================================
# ClearWay Data — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# Must match the clearway-infra database configuration.
# -----------------------------------------------------------------------------
DB_USER=clearway
DB_PASSWORD=change_me
DB_HOST=clearway-db         # Docker service name; use 127.0.0.1 for local dev
DB_PORT=5432
DB_NAME=clearway

# Assembled automatically from the above — override only if needed
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -----------------------------------------------------------------------------
# JWT Authentication
# Generate a strong key: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Celery Worker Scaling
# Tune to available RAM:
#   4 GB  / 1 worker container  → CELERY_CONCURRENCY=2
#   8 GB  / 2 worker containers → CELERY_CONCURRENCY=3
#   16 GB / 4 worker containers → CELERY_CONCURRENCY=6
# -----------------------------------------------------------------------------
CELERY_CONCURRENCY=2
